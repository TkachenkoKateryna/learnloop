DB_HOST=localhost
DB_PORT=5433
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me
DB_SYNC=1

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use two different values. Expiries use the `ms` format (e.g. 15m, 1d, 30d);
# a bare number such as "10" means milliseconds.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=1d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d

PASSWORD_RESET_TOKEN_EXPIRES_IN=30m
# Base URL of the frontend's reset-password page; the token is appended as ?token=...
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# SendGrid API key used to send transactional email (password reset, etc).
SENDGRID_API_KEY=change-me
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=LearnLoop

# Global rate limit: at most THROTTLE_LIMIT requests per THROTTLE_TTL ms per IP.
# Auth routes (login, register, forgot/reset password) set tighter limits in code.
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Frontend origins allowed to call the API with cookies, comma-separated.
# Scheme + host + port only, no trailing slash (e.g. http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
